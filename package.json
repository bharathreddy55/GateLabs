{
  "name": "gate-prep-platform",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --experimental-vm-modules --test tests/*.test.mjs",
    "test:browser": "node tests/exams.browser.mjs",
    "build:exam-banks": "node scripts/build-exam-banks.mjs",
    "test:workspace": "node tests/workspace.browser.mjs",
    "test:rules": "firebase emulators:exec --only firestore --project demo-gatelabs \"node tests/firestore.rules.mjs\"",
    "test:auth": "node tests/authRestore.browser.mjs",
    "test:libraries": "node tests/libraries.browser.mjs",
    "test:browser:all": "npm run test:browser && npm run test:workspace && npm run test:auth && npm run test:libraries"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^3.0.4",
    "autoprefixer": "^10.4.19",
    "firebase-tools": "^15.36.0",
    "playwright": "^1.65.1",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.4",
    "vite": "^5.2.11"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^7.3.1",
    "chart.js": "^4.4.3",
    "firebase": "^10.12.2",
    "katex": "^0.19.1",
    "pdf-parse": "^2.4.5",
    "pdfjs-dist": "^6.5.438"
  }
}
