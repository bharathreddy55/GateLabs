rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owns(data) { return signedIn() && data.userId == request.auth.uid; }
    match /attempts/{attemptId} {
      allow create: if owns(request.resource.data) && request.resource.data.id == attemptId;
      allow read: if owns(resource.data);
      allow delete: if signedIn() && (resource == null || owns(resource.data));
      allow update: if owns(resource.data) && owns(request.resource.data) && request.resource.data.id == attemptId;
    }
    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }
    match /questions/{questionId} {
      allow read: if true;
      allow write: if signedIn() && request.auth.token.publisher == true;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
